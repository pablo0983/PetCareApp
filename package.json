{
  "name": "petcare-app",
  "version": "3.0.9",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject"
  },
  "dependencies": {
    "@eva-design/eva": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/drawer": "^7.7.2",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "@ui-kitten/components": "^5.3.1",
    "@ui-kitten/eva-icons": "^5.3.1",
    "expo": "^58.0.25",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image-loader": "~58.0.3",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-sharing": "~58.0.23",
    "i18n-js": "^4.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.29.11",
    "react-native-modal-datetime-picker": "15.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7"
  },
  "doctor": {
    "ignore": [
      "duplicateDependencies",
      "react-native-nfc-manager"
    ],
    "reactNativeDirectoryCheck": {
      "listUnknownPackages": false,
      "ignore": [
        "react-native-nfc-manager"
      ]
    }
  },
  "expo": {
    "name": "PetCareApp",
    "slug": "petcare-app",
    "version": "3.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/pata.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pablopetry.petcareapp",
      "buildNumber": "20",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para adjuntar imágenes en incidentes.",
        "NSPhotoLibraryAddUsageDescription": "Necesitamos permiso para guardar la firma como imagen en tu dispositivo.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para adjuntar o guardar imágenes relacionadas con el incidente."
      }
    },
    "android": {
      "package": "com.pablopetry.PetCareApp",
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "daafa29d-29fd-4b32-8b99-be3cbe6833ad"
      }
    },
    "plugins": [],
    "owner": "pablopetry"
  },
  "resolutions": {
    "expo-image-loader": "6.0.0"
  }
}
